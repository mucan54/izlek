{
 "ruleset": {
  "v": 31,
  "flags": [
   {
    "key": "new_checkout",
    "enabled": true,
    "salt": "k3f9",
    "rules": [
     {
      "when": {
       "and": [
        {
         "prop": "platform",
         "op": "eq",
         "value": "ios"
        },
        {
         "prop": "app_version",
         "op": "semver_gte",
         "value": "3.2.0"
        }
       ]
      },
      "rollout": 2500,
      "variants": [
       {
        "key": "control",
        "w": 5000
       },
       {
        "key": "b",
        "w": 5000
       }
      ]
     }
    ],
    "default": null
   },
   {
    "key": "everyone",
    "enabled": true,
    "salt": "s1",
    "rules": [
     {
      "rollout": 10000
     }
    ],
    "default": null
   },
   {
    "key": "nobody",
    "enabled": true,
    "salt": "s2",
    "rules": [
     {
      "rollout": 0
     }
    ],
    "default": null
   },
   {
    "key": "disabled_with_default",
    "enabled": false,
    "salt": "s3",
    "rules": [
     {
      "rollout": 10000
     }
    ],
    "default": "legacy"
   },
   {
    "key": "half",
    "enabled": true,
    "salt": "h",
    "rules": [
     {
      "rollout": 5000
     }
    ],
    "default": false
   },
   {
    "key": "sticky",
    "enabled": true,
    "salt": "st",
    "rules": [
     {
      "rollout": 5000,
      "stable_on": "anon_id",
      "variants": [
       {
        "key": "a",
        "w": 3333
       },
       {
        "key": "b",
        "w": 3333
       },
       {
        "key": "c",
        "w": 3334
       }
      ]
     }
    ],
    "default": null
   },
   {
    "key": "first_match_decides",
    "enabled": true,
    "salt": "fm",
    "rules": [
     {
      "when": {
       "prop": "plan",
       "op": "eq",
       "value": "pro"
      },
      "rollout": 0
     },
     {
      "rollout": 10000
     }
    ],
    "default": "fallback"
   },
   {
    "key": "ops",
    "enabled": true,
    "salt": "o",
    "rules": [
     {
      "when": {
       "or": [
        {
         "prop": "age",
         "op": "gte",
         "value": 18
        },
        {
         "prop": "country",
         "op": "in",
         "value": [
          "TR",
          "DE"
         ]
        },
        {
         "prop": "email",
         "op": "regex",
         "value": "@example\\.com$"
        },
        {
         "not": {
          "prop": "plan",
          "op": "is_set"
         }
        }
       ]
      },
      "rollout": 10000,
      "variants": [
       {
        "key": "x",
        "w": 10000
       }
      ]
     }
    ],
    "default": null
   },
   {
    "key": "ops2",
    "enabled": true,
    "salt": "o2",
    "rules": [
     {
      "when": {
       "and": [
        {
         "prop": "name",
         "op": "contains",
         "value": "ali"
        },
        {
         "prop": "tier",
         "op": "not_in",
         "value": [
          1,
          2
         ]
        },
        {
         "prop": "score",
         "op": "lt",
         "value": "10.5"
        },
        {
         "prop": "build",
         "op": "ne",
         "value": 7
        },
        {
         "prop": "app_version",
         "op": "semver_lt",
         "value": "v4"
        }
       ]
      },
      "rollout": 10000
     }
    ],
    "default": null
   },
   {
    "key": "short_weights",
    "enabled": true,
    "salt": "sw",
    "rules": [
     {
      "rollout": 10000,
      "variants": [
       {
        "key": "only",
        "w": 1
       }
      ]
     }
    ],
    "default": null
   },
   {
    "key": "empty_and",
    "enabled": true,
    "salt": "ea",
    "rules": [
     {
      "when": {
       "and": []
      },
      "rollout": 10000
     }
    ],
    "default": null
   },
   {
    "key": "empty_or",
    "enabled": true,
    "salt": "eo",
    "rules": [
     {
      "when": {
       "or": []
      },
      "rollout": 10000
     }
    ],
    "default": "none-matched"
   }
  ]
 },
