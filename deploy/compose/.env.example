# openssl rand -hex 32
LA_QUERY_INTERNAL_SECRET=
# TLS sonlandıran vekilin arkasındaysanız 1 (vekil sayısı); doğrudan açıksa 0.
LA_TRUSTED_PROXIES=0
# Yalnızca yerel HTTP denemesi için false.
LA_COOKIE_SECURE=true
# Kanarya için ayrı bir proje açıp token ve "query" kapsamlı anahtar üretin.
LA_CANARY_TOKEN=
LA_CANARY_QUERY_KEY=
